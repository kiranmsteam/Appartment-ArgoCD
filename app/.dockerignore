# .dockerignore – files to exclude from Docker build context
.git/
.github/
.env
.env.*
!.env.example

# Local data (stored in Google Sheets on cloud deployments)
data/
Apartment/uploads/
Apartment/announcement_uploads/

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Secrets — never bake into the image
*service_account*.json
*credentials*.json
*-key.json
google_credentials/

# Dev artefacts
venv/
.venv/
*.egg-info/
dist/
build/

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
README.md
